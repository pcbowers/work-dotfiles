[user]
  name = {{ .name }}
  email = {{ .play_email }}
  signingkey = {{ onepasswordRead "op://private/github/public key" }}

[gpg]
  format = ssh

[gpg "ssh"]
  program = "/opt/1Password/op-ssh-sign"
  allowedSignersFile = ~/.ssh/allowed_signers

[commit]
  gpgsign = true

[includeIf "hasconfig:remote.*.url:git@ssh.dev.azure.com:**"]
  path = ~/.config/git/azure.gitconfig
[includeIf "hasconfig:remote.*.url:https://*dev.azure.com/**"]
  path = ~/.config/git/azure.gitconfig

[includeIf "hasconfig:remote.*.url:ssh://git@bitbucket.liberty.edu:**"]
  path = ~/.config/git/bitbucket.gitconfig
[includeIf "hasconfig:remote.*.url:https://bitbucket.liberty.edu/**"]
  path = ~/.config/git/bitbucket.gitconfig
