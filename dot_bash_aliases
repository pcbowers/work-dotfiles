#!/bin/bash

# cd
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias ~='cd ~'
alias projects='cd $HOME/projects'
alias bitbucket='cd $HOME/projects/bitbucket'
alias azure='cd $HOME/projects/azure'
alias github='cd $HOME/projects/github'

# ls
alias ls='eza --group-directories-first --icons'
alias lt='eza --tree --level=2 --icons'
alias la='ls -a'
alias ll='ls -lh --git --git-repos'
alias lla='ll -a'
alias lta='lt -a'

# cat
alias cat='bat'

# git
alias gs='git status'
alias ga='git add -A'
alias gp='git pull'
alias gf='git fetch'

#fzf
alias ff="fzf --preview 'bat --style=numbers --color=always {}'"

# Ubuntu specific
alias upup='sudo apt update && sudo apt upgrade'
alias clean='sudo apt autoremove'
alias ifconfig='ip addr show'
alias ge='gnome-text-editor'

# tools
alias p='pnpm'
alias d='docker'
alias bat='batcat'
alias lzg='lazygit'
alias lzd='lazydocker'
alias gradlew='./gradlew'
alias n='nvim'

# Easy source when making edits
alias sf='source $HOME/.bashrc'

# Add an alert alias for long running commands
alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'
