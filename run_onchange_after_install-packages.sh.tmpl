#!/bin/bash

set -euo pipefail

# ── Helpers ───────────────────────────────────────────────────────────────────
log()     { printf '  \033[34m→\033[0m  %s\n' "$*"; }
ok()      { printf '  \033[32m✓\033[0m  %s\n' "$*"; }
warn()    { printf '  \033[33m⚠\033[0m  %s\n' "$*"; }
section() { printf '\n\033[1;36m── %s ──\033[0m\n' "$*"; }

apt_installed()       { dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q "install ok installed"; }
cmd_exists()          { command -v "$1" &>/dev/null; }
flatpak_installed()   { flatpak list --app --columns=application 2>/dev/null | grep -qx "$1"; }
extension_installed() { gnome-extensions list 2>/dev/null | grep -qx "$1"; }

install_apt_key() {
  local key_url="$1" key_path="$2"
  if [ ! -f "$key_path" ]; then
    sudo mkdir -p /etc/apt/keyrings
    curl -fsSL "$key_url" | sudo gpg --dearmor --yes -o "$key_path"
    sudo chmod a+r "$key_path"
  fi
}

# ── APT ───────────────────────────────────────────────────────────────────────
section "APT Packages"

sudo apt-get update -q

{{ range .packages.apt -}}
if apt_installed "{{ . }}"; then
  ok "{{ . }}"
else
  log "Installing {{ . }}..."
  sudo apt-get install -y "{{ . }}"
  ok "{{ . }} installed"
fi
{{ end -}}

# ── Mise + Tools ──────────────────────────────────────────────────────────────
section "Mise + Tools"

if ! cmd_exists mise; then
  log "Installing mise..."
  curl https://mise.run | sh
fi

log "Installing mise tools..."
"$HOME/.local/bin/mise" install
ok "Mise tools ready"

# ── Flatpak ───────────────────────────────────────────────────────────────────
section "Flatpak"

if ! cmd_exists flatpak; then
  log "Installing flatpak..."
  sudo apt-get install -y flatpak
  flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
  ok "flatpak ready"
fi

{{ range .packages.flatpak -}}
if flatpak_installed "{{ . }}"; then
  ok "{{ . }}"
else
  log "Installing {{ . }}..."
  flatpak install -y flathub "{{ . }}"
  ok "{{ . }} installed"
fi
{{ end -}}

# ── GNOME Extensions ──────────────────────────────────────────────────────────
section "GNOME Extensions"

if ! cmd_exists gext; then
  log "Installing gnome-extensions-cli..."
  pip3 install gnome-extensions-cli --upgrade --break-system-packages -q
fi

{{ range .packages.extensions -}}
if extension_installed "{{ . }}"; then
  ok "{{ . }}"
else
  log "Installing {{ . }}..."
  gext install "{{ . }}"
  ok "{{ . }} installed"
fi
{{ end -}}

# ── Custom Apps ───────────────────────────────────────────────────────────────
section "Custom Apps"

{{ range .packages.custom -}}
case "{{ . }}" in
  chrome)
    if ! apt_installed "google-chrome-stable"; then
      log "Adding Google Chrome repo..."
      install_apt_key \
        "https://dl.google.com/linux/linux_signing_key.pub" \
        "/etc/apt/keyrings/google-chrome.gpg"
      sudo tee /etc/apt/sources.list.d/google-chrome.sources > /dev/null << EOF
Types: deb
URIs: https://dl.google.com/linux/chrome/deb/
Suites: stable
Components: main
Architectures: amd64
Signed-By: /etc/apt/keyrings/google-chrome.gpg
EOF
      sudo apt-get update -q
      sudo apt-get install -y google-chrome-stable
      ok "Google Chrome installed"
    else
      ok "chrome"
    fi
    ;;

  vscode)
    if ! apt_installed "code"; then
      log "Adding VS Code repo (Microsoft key)..."
      install_apt_key \
        "https://packages.microsoft.com/keys/microsoft.asc" \
        "/etc/apt/keyrings/microsoft.gpg"
      sudo tee /etc/apt/sources.list.d/vscode.sources > /dev/null << EOF
Types: deb
URIs: https://packages.microsoft.com/repos/code
Suites: stable
Components: main
Architectures: $(dpkg --print-architecture)
Signed-By: /etc/apt/keyrings/microsoft.gpg
EOF
      sudo apt-get update -q
      sudo apt-get install -y code
      ok "VS Code installed"
    else
      ok "vscode"
    fi
    ;;

  spotify)
    if ! apt_installed "spotify-client"; then
      log "Adding Spotify repo..."
      install_apt_key \
        "https://download.spotify.com/debian/pubkey_5384CE82BA52C83A.asc" \
        "/etc/apt/keyrings/spotify.gpg"
      sudo tee /etc/apt/sources.list.d/spotify.sources > /dev/null << EOF
Types: deb
URIs: https://repository.spotify.com
Suites: stable
Components: non-free
Signed-By: /etc/apt/keyrings/spotify.gpg
EOF
      sudo apt-get update -q
      sudo apt-get install -y spotify-client
      ok "Spotify installed"
    else
      ok "spotify"
    fi
    ;;

  docker)
    if ! apt_installed "docker-ce"; then
      log "Adding Docker repo..."
      sudo apt-get install -y ca-certificates curl
      sudo install -m 0755 -d /etc/apt/keyrings
      sudo curl -fsSL https://download.docker.com/linux/ubuntu/gpg \
        -o /etc/apt/keyrings/docker.asc
      sudo chmod a+r /etc/apt/keyrings/docker.asc
      sudo tee /etc/apt/sources.list.d/docker.sources > /dev/null << EOF
Types: deb
URIs: https://download.docker.com/linux/ubuntu
Suites: $(. /etc/os-release && echo "${UBUNTU_CODENAME:-$VERSION_CODENAME}")
Components: stable
Architectures: $(dpkg --print-architecture)
Signed-By: /etc/apt/keyrings/docker.asc
EOF
      sudo apt-get update -q
      sudo apt-get install -y \
        docker-ce docker-ce-cli containerd.io \
        docker-buildx-plugin docker-compose-plugin
      sudo systemctl start docker
      ok "Docker installed"

      # docker login
      # docker login nxrm.liberty.edu:5000
      # docker login nexus.liberty.edu:5001
      # docker login nexus.liberty.edu:5002
      # docker login nexus.liberty.edu:5999
      # docker login registry.redhat.io
    else
      ok "docker"
    fi

    if ! groups "$USER" | grep -qw docker; then
      sudo usermod -aG docker "$USER"
      warn "Docker: log out and back in for group membership to take effect"
    else
      ok "docker group"
    fi
    ;;

  azure-cli)
    if ! apt_installed "azure-cli"; then
      log "Adding Azure CLI repo (reuses Microsoft key)..."
      install_apt_key \
        "https://packages.microsoft.com/keys/microsoft.asc" \
        "/etc/apt/keyrings/microsoft.gpg"
      sudo tee /etc/apt/sources.list.d/azure-cli.sources > /dev/null << EOF
Types: deb
URIs: https://packages.microsoft.com/repos/azure-cli/
Suites: $(lsb_release -cs)
Components: main
Architectures: $(dpkg --print-architecture)
Signed-By: /etc/apt/keyrings/microsoft.gpg
EOF
      sudo apt-get update -q
      sudo apt-get install -y azure-cli
      ok "Azure CLI installed"
    else
      ok "azure-cli"
    fi
    ;;

  typora)
    if ! apt_installed "typora"; then
      log "Adding Typora repo..."
      sudo mkdir -p /etc/apt/keyrings
      curl -fsSL https://downloads.typora.io/typora.gpg \
        | sudo tee /etc/apt/keyrings/typora.gpg > /dev/null
      sudo tee /etc/apt/sources.list.d/typora.sources > /dev/null << EOF
Types: deb
URIs: https://downloads.typora.io/linux
Suites: ./
Signed-By: /etc/apt/keyrings/typora.gpg
EOF
      sudo apt-get update -q
      sudo apt-get install -y typora
      ok "Typora installed"
    else
      ok "typora"
    fi
    ;;

  vicinae)
    if ! cmd_exists vicinae; then
      log "Installing Vicinae..."
      curl -fsSL https://vicinae.com/install | bash
      systemctl --user enable vicinae --now
      ok "Vicinae installed"
    else
      ok "vicinae"
    fi
    ;;

  *)
    warn "No installer defined for '{{ . }}' — skipping"
    ;;
esac
{{ end -}}


# ── settings ──────────────────────────────────────────────────────────────────
section "Settings"

{{ range .settings -}}
{{ . }}
{{ end }}
ok "Settings applied"

# ── Custom Keybindings ────────────────────────────────────────────────────────
section "Custom Keybindings"

{{ $base := "/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings" -}}
{{ $kbs := .custom_keybindings -}}

gsettings set org.gnome.settings-daemon.plugins.media-keys custom-keybindings \
  "[{{ range $i, $kb := $kbs }}{{ if $i }}, {{ end }}'{{ $base }}/custom{{ $i }}/'{{ end }}]"

{{ range $i, $kb := $kbs -}}
gsettings set org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:{{ $base }}/custom{{ $i }}/ name '{{ $kb.name }}'
gsettings set org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:{{ $base }}/custom{{ $i }}/ command '{{ $kb.command }}'
gsettings set org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:{{ $base }}/custom{{ $i }}/ binding '{{ $kb.binding }}'
ok "{{ $kb.name }}"

{{ end -}}

printf '\n\033[32m✓ Done!\033[0m\n'
